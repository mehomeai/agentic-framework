# Local-only example. NEVER commit a filled-in file under this name.
# Remote-model synthetic tests require BOTH of these; household data must
# never be sent to a remote provider. NOTE: provider=openai/anthropic always
# requires the opt-in, even for localhost URLs.
ME_RUNTIME_ALLOW_REMOTE=
ME_RUNTIME_MODEL_API_KEY=
# Bounded generated-code execution additionally requires Docker mode plus
# pre-provisioned images (no implicit pulls, no host fallback):
ME_RUNTIME_SANDBOX=
ME_RUNTIME_DOCKER_IMAGE_PY=python:3.12-slim
ME_RUNTIME_DOCKER_IMAGE_NODE=node:24-slim
# Local-first model endpoint (Ollama default):
ME_RUNTIME_LOCAL_ENDPOINT=http://127.0.0.1:11434
# Strict checkpoint deserialization (GHSA-g48c-2wqr-h844 / CVE-2026-28277):
# allowlist-only msgpack, no pickle fallback. Bridge defaults to true;
# explicit opt-out (false) is unsupported in production.
LANGGRAPH_STRICT_MSGPACK=true
